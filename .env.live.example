# Dedicated test account. Never commit credentials.
QODER_FORWARD_BASE_URL=https://api.qoder.com/api/v1/forward
QODER_FORWARD_PAT=
QODER_FORWARD_MODEL=
QODER_FORWARD_LIVE_ALLOW_WRITE=false
QODER_FORWARD_LIVE_ALLOW_EXECUTION=false
QODER_FORWARD_LIVE_ALLOW_CHANNEL=false
QODER_FORWARD_LIVE_TIMEOUT_SECONDS=15
# Optional existing session for the two read-only shared SSE cases.
QODER_FORWARD_LIVE_SESSION_ID=

QODER_MANAGED_BASE_URL=https://api.qoder.com/api/v1/cloud
QODER_MANAGED_PAT=
QODER_MANAGED_MODEL=
QODER_MANAGED_LIVE_ALLOW_WRITE=false
QODER_MANAGED_LIVE_ALLOW_EXECUTION=false
QODER_MANAGED_LIVE_TIMEOUT_SECONDS=15

# Execution wait and each independent cleanup operation deadline.
QODER_E2E_TIMEOUT_SECONDS=180
